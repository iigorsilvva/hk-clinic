      <section id="section-lancamentos" class="section-view hidden">
        <section class="panel">
          <div class="section-head">
            <div>
              <h3>Todos os lançamentos</h3>
              <p>Visualize tudo o que foi lançado, com filtro por mês, tipo, conta e forma de pagamento.</p>
            </div>
            <div class="tabs" id="monthTabs"></div>
          </div>

          <div class="filters">
            <div class="field">
              <label for="searchInput">Buscar</label>
              <input id="searchInput" type="text" placeholder="Buscar por descrição ou responsável">
            </div>
            <div class="field">
              <label for="filterTipo">Tipo</label>
              <select id="filterTipo">
                <option value="todos">Todos</option>
                <option value="entrada">Entrada</option>
                <option value="saida">Saída</option>
