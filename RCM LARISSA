          <div id="transactionsEmpty" class="empty hidden">Nenhum lançamento encontrado.</div>
        </section>
      </section>

      <section id="section-graficos" class="section-view hidden">
        <div class="grid-main">
          <section class="panel">
            <div class="section-head">
              <div>
                <h3>Gráficos por mês</h3>
                <p>Escolha um mês e veja gastos, entradas e distribuição de saídas por categoria.</p>
              </div>
              <div class="field" style="min-width:220px">
                <label for="chartMonthSelect">Mês do gráfico</label>
                <select id="chartMonthSelect"></select>
              </div>
            </div>
            <div class="chart-wrap">
              <canvas id="monthChart" height="260"></canvas>
            </div>
          </section>

          <section class="panel">
            <div class="section-head">
              <div>
                <h3>Gastos do mês</h3>
                <p>Visual premium das despesas por categoria no mês selecionado.</p>
              </div>
            </div>
            <div class="chart-wrap">
              <canvas id="categoryChart" height="260"></canvas>
            </div>
          </section>
        </div>
      </section>

      <section id="section-contas" class="section-view hidden">
        <div class="grid-main">
          <section class="panel">
            <div class="section-head">
              <div>
                <h3>Nova conta a pagar</h3>
                <p>Cadastre a conta mensal e marque como paga, pendente ou vencida.</p>
              </div>
            </div>

            <form id="billForm">
              <div class="form-grid">
                <div class="field">
                  <label for="billDescricao">Descrição da conta</label>
                  <input id="billDescricao" type="text" placeholder="Ex.: Água, internet, aluguel" required>
                </div>
                <div class="field">
                  <label for="billValor">Valor</label>
                  <input id="billValor" type="number" step="0.01" min="0" placeholder="0,00" required>
                </div>
                <div class="field">
                  <label for="billCategoria">Categoria</label>
                  <select id="billCategoria">
                    <option value="Moradia">Moradia</option>
                    <option value="Serviços">Serviços</option>
                    <option value="Saúde">Saúde</option>
                    <option value="Alimentação">Alimentação</option>
                    <option value="Transporte">Transporte</option>
                    <option value="Outros">Outros</option>
                  </select>
                </div>
                <div class="field">
                  <label for="billMetodo">Forma de pagamento</label>
                  <select id="billMetodo">
                    <option value="PIX">PIX</option>
                    <option value="Cartão">Cartão</option>
                    <option value="Dinheiro">Dinheiro</option>
                    <option value="Cheque">Cheque</option>
                    <option value="Transferência">Transferência</option>
                  </select>
                </div>
                <div class="field">
                  <label for="billConta">Conta</label>
                  <select id="billConta">
                    <option value="Casa">Casa</option>
                    <option value="Conta Pessoal">Conta Pessoal</option>
                    <option value="Conta Conjunta">Conta Conjunta</option>
                  </select>
                </div>
                <div class="field">
                  <label for="billResponsavel">Responsável</label>
                  <input id="billResponsavel" type="text" placeholder="Ex.: Igor, casal">
                </div>
                <div class="field">
                  <label for="billData">Vencimento</label>
                  <input id="billData" type="date" required>
                </div>
                <div class="field">
                  <label for="billStatus">Status</label>
                  <select id="billStatus">
                    <option value="pendente">Pendente</option>
                    <option value="paga">Paga</option>
                    <option value="vencida">Vencida</option>
                  </select>
                </div>
              </div>
              <div class="actions-row">
                <button class="btn btn-primary" type="submit">Salvar conta</button>
              </div>
            </form>
          </section>

          <section class="panel">
            <div class="section-head">
              <div>
                <h3>Status rápido</h3>
                <p>Controle contas em aberto e acompanhe quantas já foram pagas.</p>
              </div>
            </div>
            <div class="grid-4" style="grid-template-columns:repeat(3,1fr)">
              <div class="compare-box">
                <span class="t">Pagas</span>
                <span class="v" id="billsPaid">0</span>
              </div>
              <div class="compare-box">
                <span class="t">Pendentes</span>
                <span class="v" id="billsPending">0</span>
              </div>
              <div class="compare-box">
                <span class="t">Vencidas</span>
                <span class="v" id="billsOverdue">0</span>
              </div>
            </div>
          </section>
        </div>

        <section class="panel">
          <div class="section-head">
            <div>
              <h3>Contas do mês</h3>
              <p>Ao dar baixa em “Paga”, a despesa entra automaticamente nos lançamentos e nos gráficos.</p>
            </div>
          </div>

          <div class="filters" style="grid-template-columns:1.2fr .9fr .9fr .9fr">
            <div class="field">
              <label for="billSearchInput">Buscar conta</label>
              <input id="billSearchInput" type="text" placeholder="Buscar por descrição ou responsável">
            </div>
            <div class="field">
              <label for="billStatusFilter">Status</label>
              <select id="billStatusFilter">
                <option value="todos">Todos</option>
                <option value="paga">Paga</option>
                <option value="pendente">Pendente</option>
                <option value="vencida">Vencida</option>
              </select>
            </div>
            <div class="field">
              <label for="billMonthFilter">Mês</label>
              <select id="billMonthFilter"><option value="todos">Todos</option></select>
            </div>
            <div class="field">
              <label for="billContaFilter">Conta</label>
              <select id="billContaFilter"><option value="todos">Todas</option></select>
            </div>
          </div>

          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Vencimento</th>
                  <th>Descrição</th>
                  <th>Status</th>
                  <th>Categoria</th>
                  <th>Forma</th>
                  <th>Conta</th>
                  <th>Responsável</th>
                  <th>Valor</th>
                  <th>Ação</th>
                </tr>
              </thead>
              <tbody id="billsBody"></tbody>
            </table>
          </div>
          <div id="billsEmpty" class="empty hidden">Nenhuma conta encontrada.</div>
        </section>
      </section>

      <div class="print-only">
        <h2>FinFlow Premium</h2>
      </div>
    </main>
  </div>

  <script>
    const STORAGE = {
      user: 'finflow_user_v1',
      transactions: 'finflow_transactions_v1',
      bills: 'finflow_bills_v1'
    };

    const currency = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' });

    let transactions = safeParse(localStorage.getItem(STORAGE.transactions), []);
    let bills = safeParse(localStorage.getItem(STORAGE.bills), []);
    let compareChart, monthChart, categoryChart;
    let activeSection = 'dashboard';

    const els = {
      loginScreen: document.getElementById('loginScreen'),
      loginEmail: document.getElementById('loginEmail'),
      loginPassword: document.getElementById('loginPassword'),
      loginBtn: document.getElementById('loginBtn'),

      transactionForm: document.getElementById('transactionForm'),
      billForm: document.getElementById('billForm'),

      transactionsBody: document.getElementById('transactionsBody'),
      transactionsEmpty: document.getElementById('transactionsEmpty'),
      billsBody: document.getElementById('billsBody'),
      billsEmpty: document.getElementById('billsEmpty'),

      metricSaldo: document.getElementById('metricSaldo'),
      metricEntradas: document.getElementById('metricEntradas'),
      metricSaidas: document.getElementById('metricSaidas'),
      metricPendentes: document.getElementById('metricPendentes'),

      currentMonthSaldo: document.getElementById('currentMonthSaldo'),
      previousMonthSaldo: document.getElementById('previousMonthSaldo'),
      monthDiff: document.getElementById('monthDiff'),

      billsPaid: document.getElementById('billsPaid'),
      billsPending: document.getElementById('billsPending'),
      billsOverdue: document.getElementById('billsOverdue'),

      searchInput: document.getElementById('searchInput'),
      filterTipo: document.getElementById('filterTipo'),
      filterConta: document.getElementById('filterConta'),
      filterMetodo: document.getElementById('filterMetodo'),
      filterMonth: document.getElementById('filterMonth'),

      billSearchInput: document.getElementById('billSearchInput'),
      billStatusFilter: document.getElementById('billStatusFilter'),
      billMonthFilter: document.getElementById('billMonthFilter'),
      billContaFilter: document.getElementById('billContaFilter'),

      chartMonthSelect: document.getElementById('chartMonthSelect'),
      monthTabs: document.getElementById('monthTabs'),

      exportCsvBtn: document.getElementById('exportCsvBtn'),
      exportPdfBtn: document.getElementById('exportPdfBtn'),
      exportJsonBtn: document.getElementById('exportJsonBtn'),
      importFile: document.getElementById('importFile'),
      demoBtn: document.getElementById('demoBtn'),
      resetBtn: document.getElementById('resetBtn')
    };

    document.getElementById('data').valueAsDate = new Date();
    document.getElementById('billData').valueAsDate = new Date();

    document.querySelectorAll('.nav-btn').forEach(btn => {
      btn.addEventListener('click', () => showSection(btn.dataset.section));
    });

    els.loginBtn.addEventListener('click', handleLogin);

    els.transactionForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const item = {
        id: crypto.randomUUID(),
        descricao: val('descricao'),
        valor: Number(val('valor')),
        tipo: val('tipo'),
        categoria: val('categoria'),
        metodo: val('metodo'),
        conta: val('conta'),
        responsavel: val('responsavel') || 'Não informado',
        data: val('data'),
        obs: val('obs')
      };

      if (!item.descricao || !item.valor || item.valor <= 0 || !item.data) {
        alert('Preencha descrição, valor e data corretamente.');
        return;
      }

      transactions.unshift(item);
      persist();
      els.transactionForm.reset();
      document.getElementById('data').valueAsDate = new Date();
      renderAll();
      showSection('lancamentos');
    });

    els.billForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const bill = {
        id: crypto.randomUUID(),
        descricao: val('billDescricao'),
        valor: Number(val('billValor')),
        categoria: val('billCategoria'),
        metodo: val('billMetodo'),
        conta: val('billConta'),
        responsavel: val('billResponsavel') || 'Não informado',
        data: val('billData'),
        status: val('billStatus'),
        linkedTransactionId: null
      };

      if (!bill.descricao || !bill.valor || bill.valor <= 0 || !bill.data) {
        alert('Preencha descrição, valor e vencimento corretamente.');
        return;
      }

      bills.unshift(bill);

      if (bill.status === 'paga') {
        createTransactionFromBill(bill);
      }

      persist();
      els.billForm.reset();
      document.getElementById('billData').valueAsDate = new Date();
      renderAll();
    });

    [els.searchInput, els.filterTipo, els.filterConta, els.filterMetodo, els.filterMonth].forEach(el => {
      el.addEventListener('input', renderTransactionsTable);
      el.addEventListener('change', renderTransactionsTable);
    });

    [els.billSearchInput, els.billStatusFilter, els.billMonthFilter, els.billContaFilter].forEach(el => {
      el.addEventListener('input', renderBillsTable);
      el.addEventListener('change', renderBillsTable);
    });

    els.chartMonthSelect.addEventListener('change', renderGraphsSection);

    els.exportCsvBtn.addEventListener('click', exportCsv);
    els.exportPdfBtn.addEventListener('click', () => window.print());
    els.exportJsonBtn.addEventListener('click', exportJson);
    els.importFile.addEventListener('change', importJson);
    els.demoBtn.addEventListener('click', loadDemo);
    els.resetBtn.addEventListener('click', resetAll);

    autoLogin();
    renderAll();

    function autoLogin() {
      const saved = safeParse(localStorage.getItem(STORAGE.user), null);
      if (saved && saved.email) {
        els.loginScreen.classList.add('hidden');
      }
    }

    function handleLogin() {
      const email = els.loginEmail.value.trim();
      const password = els.loginPassword.value.trim();
      if (!email || !password) {
        alert('Preencha email e senha.');
        return;
      }
      localStorage.setItem(STORAGE.user, JSON.stringify({ email }));
      els.loginScreen.classList.add('hidden');
    }

    function showSection(section) {
      activeSection = section;
      document.querySelectorAll('.section-view').forEach(sec => sec.classList.add('hidden'));
      document.getElementById('section-' + section).classList.remove('hidden');

      document.querySelectorAll('.nav-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.section === section);
      });

      if (section === 'graficos') renderGraphsSection();
      if (section === 'lancamentos') renderTransactionsTable();
      if (section === 'contas') renderBillsTable();
    }

    function val(id) {
      return document.getElementById(id).value.trim();
    }

    function safeParse(raw, fallback) {
      try { return raw ? JSON.parse(raw) : fallback; } catch { return fallback; }
    }

    function persist() {
      localStorage.setItem(STORAGE.transactions, JSON.stringify(transactions));
      localStorage.setItem(STORAGE.bills, JSON.stringify(bills));
    }

    function formatDate(value) {
      if (!value) return '-';
      const [y, m, d] = value.split('-');
      return `${d}/${m}/${y}`;
    }

    function getMonthKey(dateStr) {
      const d = new Date(dateStr + 'T00:00:00');
      const y = d.getFullYear();
      const m = String(d.getMonth() + 1).padStart(2, '0');
      return `${y}-${m}`;
    }

    function monthLabel(key) {
      const [y, m] = key.split('-');
      const dt = new Date(Number(y), Number(m)-1, 1);
      return dt.toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' });
    }

    function getAllMonthKeys() {
      const keys = new Set();
      transactions.forEach(t => keys.add(getMonthKey(t.data)));
      bills.forEach(b => keys.add(getMonthKey(b.data)));
      if (!keys.size) keys.add(getMonthKey(new Date().toISOString().slice(0,10)));
      return Array.from(keys).sort().reverse();
    }

    function fillSelectWithMonths(selectEl, includeTodos=true) {
      const current = selectEl.value;
      const options = getAllMonthKeys();
      selectEl.innerHTML = includeTodos ? '<option value="todos">Todos</option>' : '';
      options.forEach(k => {
        const o = document.createElement('option');
        o.value = k;
        o.textContent = monthLabel(k);
        selectEl.appendChild(o);
      });
      if (!includeTodos && options.length && !options.includes(current)) {
        selectEl.value = options[0];
      } else if (includeTodos && current && Array.from(selectEl.options).some(o => o.value === current)) {
        selectEl.value = current;
      } else if (!includeTodos && options.length) {
        selectEl.value = options[0];
      }
    }

    function renderMonthTabs() {
      const months = getAllMonthKeys().slice(0, 6);
      const activeMonth = els.filterMonth.value !== 'todos' ? els.filterMonth.value : (months[0] || 'todos');
      els.monthTabs.innerHTML = '';
      months.forEach(k => {
        const btn = document.createElement('button');
        btn.className = 'tab-filter' + (k === activeMonth ? ' active' : '');
        btn.textContent = monthLabel(k);
        btn.addEventListener('click', () => {
          els.filterMonth.value = k;
          renderMonthTabs();
          renderTransactionsTable();
        });
        els.monthTabs.appendChild(btn);
      });
    }

    function renderContaFilters() {
      const contas = new Set([...transactions.map(t => t.conta), ...bills.map(b => b.conta)]);
      const arr = Array.from(contas).sort();
      syncOptionList(els.filterConta, arr, true);
      syncOptionList(els.billContaFilter, arr, true);
    }

    function syncOptionList(select, items, includeTodos) {
      const current = select.value;
      select.innerHTML = includeTodos ? '<option value="todos">Todas</option>' : '';
      items.forEach(item => {
        const o = document.createElement('option');
        o.value = item;
        o.textContent = item;
        select.appendChild(o);
      });
      if ([...select.options].some(o => o.value === current)) select.value = current;
    }

    function getFilteredTransactions() {
      const q = els.searchInput.value.trim().toLowerCase();
      return transactions.filter(t => {
        const matchText = !q || t.descricao.toLowerCase().includes(q) || (t.responsavel || '').toLowerCase().includes(q);
        const matchTipo = els.filterTipo.value === 'todos' || t.tipo === els.filterTipo.value;
        const matchConta = els.filterConta.value === 'todos' || t.conta === els.filterConta.value;
        const matchMetodo = els.filterMetodo.value === 'todos' || t.metodo === els.filterMetodo.value;
        const matchMonth = els.filterMonth.value === 'todos' || getMonthKey(t.data) === els.filterMonth.value;
        return matchText && matchTipo && matchConta && matchMetodo && matchMonth;
      });
    }

    function getFilteredBills() {
      const q = els.billSearchInput.value.trim().toLowerCase();
      return bills.filter(b => {
        const matchText = !q || b.descricao.toLowerCase().includes(q) || (b.responsavel || '').toLowerCase().includes(q);
        const matchStatus = els.billStatusFilter.value === 'todos' || b.status === els.billStatusFilter.value;
        const matchMonth = els.billMonthFilter.value === 'todos' || getMonthKey(b.data) === els.billMonthFilter.value;
        const matchConta = els.billContaFilter.value === 'todos' || b.conta === els.billContaFilter.value;
        return matchText && matchStatus && matchMonth && matchConta;
      });
    }

    function renderMetrics() {
      const currentKey = getMonthKey(new Date().toISOString().slice(0,10));
      const currentTransactions = transactions.filter(t => getMonthKey(t.data) === currentKey);
      const entradas = sum(currentTransactions.filter(t => t.tipo === 'entrada').map(t => t.valor));
      const saidas = sum(currentTransactions.filter(t => t.tipo === 'saida').map(t => t.valor));
      const saldo = entradas - saidas;
      const pendentes = bills.filter(b => b.status === 'pendente').length;

      els.metricSaldo.textContent = currency.format(saldo);
      els.metricEntradas.textContent = currency.format(entradas);
      els.metricSaidas.textContent = currency.format(saidas);
      els.metricPendentes.textContent = String(pendentes);
    }

    function renderComparison() {
      const current = new Date();
      const currKey = getMonthKey(current.toISOString().slice(0,10));
      const prevDate = new Date(current.getFullYear(), current.getMonth()-1, 1);
      const prevKey = getMonthKey(prevDate.toISOString().slice(0,10));

      const curr = monthTotals(currKey);
      const prev = monthTotals(prevKey);

      els.currentMonthSaldo.textContent = currency.format(curr.saldo);
      els.previousMonthSaldo.textContent = currency.format(prev.saldo);
      els.monthDiff.textContent = currency.format(curr.saldo - prev.saldo);

      if (compareChart) compareChart.destroy();
      compareChart = new Chart(document.getElementById('compareChart'), {
        type: 'bar',
        data: {
          labels: ['Entradas', 'Saídas', 'Saldo'],
          datasets: [
            {
              label: 'Mês atual',
              data: [curr.entradas, curr.saidas, curr.saldo],
              borderRadius: 12,
              backgroundColor: 'rgba(127, 61, 255, .82)'
            },
            {
              label: 'Mês anterior',
              data: [prev.entradas, prev.saidas, prev.saldo],
              borderRadius: 12,
              backgroundColor: 'rgba(181, 140, 255, .62)'
            }
          ]
        },
        options: baseChartOptions(false)
      });
    }

    function monthTotals(key) {
      const filtered = transactions.filter(t => getMonthKey(t.data) === key);
      const entradas = sum(filtered.filter(t => t.tipo === 'entrada').map(t => t.valor));
      const saidas = sum(filtered.filter(t => t.tipo === 'saida').map(t => t.valor));
      return { entradas, saidas, saldo: entradas - saidas };
    }

    function renderTransactionsTable() {
      const data = getFilteredTransactions();
      els.transactionsBody.innerHTML = '';
      els.transactionsEmpty.classList.toggle('hidden', !!data.length);

      data.forEach(item => {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td>${formatDate(item.data)}</td>
          <td>
            <strong>${escapeHtml(item.descricao)}</strong>
            ${item.obs ? `<div class="sub">${escapeHtml(item.obs)}</div>` : ''}
          </td>
          <td><span class="pill ${item.tipo}">${item.tipo === 'entrada' ? 'Entrada' : 'Saída'}</span></td>
          <td>${escapeHtml(item.categoria)}</td>
          <td><span class="pill pagamento">${escapeHtml(item.metodo)}</span></td>
          <td><span class="pill conta">${escapeHtml(item.conta)}</span></td>
          <td>${escapeHtml(item.responsavel || 'Não informado')}</td>
          <td><strong>${currency.format(Number(item.valor))}</strong></td>
          <td><button class="btn btn-soft" onclick="removeTransaction('${item.id}')">Excluir</button></td>
        `;
        els.transactionsBody.appendChild(tr);
      });
    }

    function renderBillsSummary() {
      els.billsPaid.textContent = String(bills.filter(b => b.status === 'paga').length);
      els.billsPending.textContent = String(bills.filter(b => b.status === 'pendente').length);
      els.billsOverdue.textContent = String(bills.filter(b => b.status === 'vencida').length);
    }

    function renderBillsTable() {
      const data = getFilteredBills();
      els.billsBody.innerHTML = '';
      els.billsEmpty.classList.toggle('hidden', !!data.length);

      data.forEach(item => {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td>${formatDate(item.data)}</td>
          <td><strong>${escapeHtml(item.descricao)}</strong></td>
          <td><span class="pill ${item.status}">${capitalize(item.status)}</span></td>
          <td>${escapeHtml(item.categoria)}</td>
          <td><span class="pill pagamento">${escapeHtml(item.metodo)}</span></td>
          <td><span class="pill conta">${escapeHtml(item.conta)}</span></td>
